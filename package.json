{
  "name": "project-basketball-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "npm run prisma:generate",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:ci": "vitest run --maxWorkers=2",
    "audit:runtime": "npm audit --omit=dev --audit-level=critical",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "seed:competition-demos": "tsx scripts/seed-competition-demos.ts",
    "seed:demo": "npm run prisma:seed && npm run seed:competition-demos",
    "reset:development": "tsx scripts/reset-development-supabase.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.110.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.26.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^29.1.1",
    "prisma": "7.10.0",
    "shadcn": "^4.14.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "fast-uri": "^3.1.8",
    "nanoid": "^3.3.18",
    "source-map-js": "^1.2.2"
  }
}
